{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meilisearch Documents Tasks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7700/tasks"
          },
          "docs": "List tasks"
        },
        {
          "info": {
            "name": "Get a task",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7700/tasks/:taskUid",
            "params": [
              {
                "name": "taskUid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a task"
        },
        {
          "info": {
            "name": "Cancel tasks",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:7700/tasks/cancel"
          },
          "docs": "Cancel tasks"
        },
        {
          "info": {
            "name": "Delete tasks",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:7700/tasks/delete"
          },
          "docs": "Delete tasks"
        }
      ]
    }
  ],
  "bundled": true
}